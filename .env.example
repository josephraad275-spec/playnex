# Copy to .env for local development. Never commit .env or put secrets in VITE_*.
PORT=3001
# Optional hosted accounts: leave empty to keep account UI unavailable.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional permanent account deletion: server only, never frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Verified registered-user UUIDs only. No guest can become an administrator.
PLAYNEX_ADMIN_IDS=
